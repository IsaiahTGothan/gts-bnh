# ─── Team sync (leave blank to run local-only) ──────────────────────────────
# Easiest: Vercel → project → Storage → Create Database → Supabase. Vercel
# injects all of these automatically; you never paste them by hand.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used once, to create the gts_sync table automatically (either works).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional. Normally the team passcode is created from the app (Settings →
# Team sync) and stored as a hash in the database. Set this to force a
# passcode from the server instead (e.g. to reset a forgotten one).
GTS_SYNC_KEY=

# ─── Salesforce (optional — "Push to Salesforce" creates a real Case) ─────────
# Ask the B&H Salesforce admin for a Connected App with the OAuth
# "Client Credentials Flow" enabled and a run-as user that can create Cases.
# Until these three are set, Push to Salesforce just marks the ticket as pushed.
SF_INSTANCE_URL=            # e.g. https://bhphoto.my.salesforce.com
SF_CLIENT_ID=               # Connected App consumer key
SF_CLIENT_SECRET=           # Connected App consumer secret
# Optional tuning
SF_API_VERSION=v61.0
SF_CASE_ORIGIN=Web          # must be a valid Case Origin picklist value
SF_CASE_RECORD_TYPE_ID=     # Case record type, if the org uses them
SF_CASE_FIELDS_JSON=        # extra fields on every Case, e.g. {"Department__c":"GTS"}
