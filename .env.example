# ─── Team sync (leave blank to run local-only) ──────────────────────────────
# Easiest: Vercel → project → Storage → Create Database → Supabase. Vercel
# injects all of these automatically; you never paste them by hand.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used once, to create the gts_sync table automatically (either works).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional. Normally the team passcode is created from the app (Settings →
# Team sync) and stored as a hash in the database. Set this to force a
# passcode from the server instead (e.g. to reset a forgotten one).
GTS_SYNC_KEY=
